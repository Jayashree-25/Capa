# Server port
PORT=3001

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# development | production | test
NODE_ENV=development

# PostgreSQL connection string (used by migrations, store, and seed)
# DATABASE_URL=postgres://capa:capa@localhost:5432/capa

# Optional: separate database for tests (created/dropped automatically by npm test)
# TEST_DATABASE_URL=postgres://capa:capa@localhost:5432/capa_test

# Secret used to sign login tokens (REQUIRED in production — set a long random string)
# JWT_SECRET=change-me-to-a-long-random-string